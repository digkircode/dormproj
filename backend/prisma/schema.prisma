// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// Один активный студент = одна зачётная книжка (ZachetnayaKnigaUID из внешнего API).
// Отчисленных/выпустившихся не храним — при синхронизации отсутствующие строки удаляются.
model Student {
  zachetnayaKnigaUid   String   @map("zachetnaya_kniga_uid")
  fizicheskoyeLitsoUid String   @map("fizicheskoye_litso_uid")
  fullName             String   @map("full_name")
  zachetnayaKniga      String   @map("zachetnaya_kniga")
  uchebYear            String   @map("ucheb_year")
  uchebPlan            String   @map("ucheb_plan")
  uchebPlanOsnova      String   @map("ucheb_plan_osnova")
  formObuch            String   @map("form_obuch")
  facultet             String
  speciality           String
  kurs                 String
  kursNumber           Int      @map("kurs_number")
  group                String   @map("study_group")
  uchebStatus          String   @map("ucheb_status")
  osnovaObuch          String   @map("osnova_obuch")
  urovenPodgotov       String   @map("uroven_podgotov")
  profilSpec           String?  @map("profil_spec")
  dot                  Boolean
  facultAbbr           String   @map("facult_abbr")
  period               DateTime

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@id([zachetnayaKnigaUid, fizicheskoyeLitsoUid])
  @@index([fizicheskoyeLitsoUid])
  @@map("students")
}

// Физическое лицо (человек), в отличие от Student — не привязано к конкретной зачётке
// (у одного человека может быть несколько). Источник данных отдаёт их по запросу с
// конкретными UID, а не полным списком, поэтому здесь никогда не делаем hard delete —
// пропавшая или помеченная DeleteMark=true запись всё равно остаётся в базе как есть.
// Только fullName обязателен. Синхрон из 1С заполняет все остальные поля всегда,
// но будущее ручное добавление на сайте (см. isManual) может завести человека
// сначала по одному имени, остальное — позже, поэтому у таблицы не может быть NOT NULL
// на всём подряд.
model Individual {
  fizicheskoyeLitsoUid String    @id @map("fizicheskoye_litso_uid")
  deleteMark           Boolean   @default(false) @map("delete_mark")
  code                 String?
  fullName             String    @map("full_name")
  surname              String?
  name                 String?
  otchestvo            String?
  gender               String?
  birthDate            DateTime? @map("birth_date")
  // Сгенерированная БД колонка (to_char(birth_date, 'DD.MM.YYYY')) — только чтобы дату
  // рождения можно было искать тем же ILIKE-поиском по тексту, что и остальные поля,
  // не переписывая весь список на сырой SQL. Приложение в неё никогда не пишет.
  birthDateText        String?   @map("birth_date_text")
  inn                  String?
  snils                String?
  photoCode            String?   @map("photo_code")
  // Заведено вручную на сайте, а не синхроном из 1С — такие записи синхрон физлиц
  // не трогает и их UID не участвует в запросе к источнику (см. individuals-sync.service.ts).
  isManual             Boolean   @default(false) @map("is_manual")

  citizenships Citizenship[]
  passports    Passport[]
  contactInfos ContactInfo[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("individuals")
}

// "Слепок", а не синхрон в смысле Student/Individual — источник отдаёт историю
// гражданств без какого-либо стабильного ключа (у одного физлица может быть
// несколько периодов), апсертить не по чему. Поэтому при каждом запуске таблица
// полностью очищается и заполняется заново (как раньше делали для Student).
// ФИО в этой таблице не хранится — только fizicheskoyeLitsoUid, ФИО подтягивается
// связью с Individual на чтении (см. citizenship.controller.ts).
model Citizenship {
  id                   Int        @id @default(autoincrement())
  fizicheskoyeLitsoUid String     @map("fizicheskoye_litso_uid")
  individual           Individual @relation(fields: [fizicheskoyeLitsoUid], references: [fizicheskoyeLitsoUid])

  period      DateTime
  // Сгенерированная БД колонка (см. birthDateText у Individual) — чтобы период
  // тоже искался обычным ILIKE, а не только точным/диапазонным сравнением дат.
  // period здесь всегда заполнен (не как birthDate у Individual), поэтому не String? —
  // dbgenerated("") ничего не меняет в реальной БД (та задаётся ручной миграцией),
  // но помечает поле как "с дефолтом", чтобы Prisma не требовал его при createMany.
  periodText  String   @default(dbgenerated()) @map("period_text")
  country     String
  countryCode String   @map("country_code")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([fizicheskoyeLitsoUid])
  @@map("citizenships")
}

// Тот же принцип "слепка", что и Citizenship — история паспортных данных без
// стабильного ключа (несколько документов на одно физлицо со временем), полная
// очистка+перезапись при каждом запуске. ФИО не хранится, только связь с Individual.
model Passport {
  id                   Int        @id @default(autoincrement())
  fizicheskoyeLitsoUid String     @map("fizicheskoye_litso_uid")
  individual           Individual @relation(fields: [fizicheskoyeLitsoUid], references: [fizicheskoyeLitsoUid])

  period        DateTime
  periodText    String   @default(dbgenerated()) @map("period_text")
  type          String
  series        String
  number        String
  dateStart     DateTime @map("date_start")
  dateStartText String   @default(dbgenerated()) @map("date_start_text")
  unit          String
  codeUnit      String   @map("code_unit")
  systemDoc     String   @map("system_doc")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([fizicheskoyeLitsoUid])
  @@map("passports")
}

// Тот же принцип "слепка" — контактов (адреса/телефоны/email/место рождения и т.д.)
// у одного физлица может быть много, стабильного ключа нет, полная очистка+перезапись
// при каждом запуске. XML/JSON — дубли Predstavleniye/Country/... в структурированном
// виде из источника; по явной просьбе храним и показываем как есть, а не отбрасываем.
model ContactInfo {
  id                   Int        @id @default(autoincrement())
  fizicheskoyeLitsoUid String     @map("fizicheskoye_litso_uid")
  individual           Individual @relation(fields: [fizicheskoyeLitsoUid], references: [fizicheskoyeLitsoUid])

  type              String
  predstavleniye    String
  xml               String
  json              String
  country           String
  region            String
  city              String
  email             String
  phoneNumber       String   @map("phone_number")
  phoneNumberNoCode String   @map("phone_number_no_code")
  // 1С отдаёт "0001-01-01" как "дата не задана" (не NULL) — храним как есть, на фронте
  // такое значение показываем как "—" (см. ContactInfo.vue).
  dateStart         DateTime @map("date_start")
  dateStartText     String   @default(dbgenerated()) @map("date_start_text")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([fizicheskoyeLitsoUid])
  @@map("contact_infos")
}

// Однорядный лок на время выполнения синхронизации данного типа — защита от параллельного запуска.
// Уникальность type делает acquire атомарным на уровне БД (create падает, если лок уже держит кто-то другой).
model SyncLock {
  type      String   @id
  startedAt DateTime @default(now()) @map("started_at")

  @@map("sync_locks")
}

model SyncLog {
  id           Int         @id @default(autoincrement())
  type         String      @default("students")
  trigger      SyncTrigger
  status       SyncStatus
  startedAt    DateTime    @default(now()) @map("started_at")
  finishedAt   DateTime?   @map("finished_at")
  fetchedCount Int?        @map("fetched_count")
  added        Int?
  updated      Int?
  removed      Int?
  errorMessage String?     @map("error_message")
  errorStack   String?     @map("error_stack")

  @@index([type, status, finishedAt])
  @@map("sync_logs")
}

enum SyncTrigger {
  CRON
  MANUAL
}

enum SyncStatus {
  RUNNING
  SUCCESS
  FAILED
}
