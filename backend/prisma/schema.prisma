// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// Один активный студент = одна зачётная книжка (ZachetnayaKnigaUID из внешнего API).
// Отчисленных/выпустившихся не храним — при синхронизации отсутствующие строки удаляются.
model Student {
  zachetnayaKnigaUid   String   @map("zachetnaya_kniga_uid")
  fizicheskoyeLitsoUid String   @map("fizicheskoye_litso_uid")
  fullName             String   @map("full_name")
  zachetnayaKniga      String   @map("zachetnaya_kniga")
  uchebYear            String   @map("ucheb_year")
  uchebPlan            String   @map("ucheb_plan")
  uchebPlanOsnova      String   @map("ucheb_plan_osnova")
  formObuch            String   @map("form_obuch")
  facultet             String
  speciality           String
  kurs                 String
  kursNumber           Int      @map("kurs_number")
  group                String   @map("study_group")
  uchebStatus          String   @map("ucheb_status")
  osnovaObuch          String   @map("osnova_obuch")
  urovenPodgotov       String   @map("uroven_podgotov")
  profilSpec           String?  @map("profil_spec")
  dot                  Boolean
  facultAbbr           String   @map("facult_abbr")
  period               DateTime

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@id([zachetnayaKnigaUid, fizicheskoyeLitsoUid])
  @@index([fizicheskoyeLitsoUid])
  @@map("students")
}

// Физическое лицо (человек), в отличие от Student — не привязано к конкретной зачётке
// (у одного человека может быть несколько). Источник данных отдаёт их по запросу с
// конкретными UID, а не полным списком, поэтому здесь никогда не делаем hard delete —
// пропавшая или помеченная DeleteMark=true запись всё равно остаётся в базе как есть.
// Только fullName обязателен. Синхрон из 1С заполняет все остальные поля всегда,
// но будущее ручное добавление на сайте (см. isManual) может завести человека
// сначала по одному имени, остальное — позже, поэтому у таблицы не может быть NOT NULL
// на всём подряд.
model Individual {
  fizicheskoyeLitsoUid String    @id @map("fizicheskoye_litso_uid")
  deleteMark           Boolean   @default(false) @map("delete_mark")
  code                 String?
  fullName             String    @map("full_name")
  surname              String?
  name                 String?
  otchestvo            String?
  gender               String?
  birthDate            DateTime? @map("birth_date")
  // Сгенерированная БД колонка (to_char(birth_date, 'DD.MM.YYYY')) — только чтобы дату
  // рождения можно было искать тем же ILIKE-поиском по тексту, что и остальные поля,
  // не переписывая весь список на сырой SQL. Приложение в неё никогда не пишет.
  birthDateText        String?   @map("birth_date_text")
  inn                  String?
  snils                String?
  photoCode            String?   @map("photo_code")
  // Заведено вручную на сайте, а не синхроном из 1С — такие записи синхрон физлиц
  // не трогает и их UID не участвует в запросе к источнику (см. individuals-sync.service.ts).
  isManual             Boolean   @default(false) @map("is_manual")

  citizenships Citizenship[]
  passports    Passport[]
  contactInfos ContactInfo[]
  users        User[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("individuals")
}

// "Слепок", а не синхрон в смысле Student/Individual — источник отдаёт историю
// гражданств без какого-либо стабильного ключа (у одного физлица может быть
// несколько периодов), апсертить не по чему. Поэтому при каждом запуске таблица
// полностью очищается и заполняется заново (как раньше делали для Student).
// ФИО в этой таблице не хранится — только fizicheskoyeLitsoUid, ФИО подтягивается
// связью с Individual на чтении (см. citizenship.controller.ts).
model Citizenship {
  id                   Int        @id @default(autoincrement())
  fizicheskoyeLitsoUid String     @map("fizicheskoye_litso_uid")
  individual           Individual @relation(fields: [fizicheskoyeLitsoUid], references: [fizicheskoyeLitsoUid])

  period      DateTime
  // Сгенерированная БД колонка (см. birthDateText у Individual) — чтобы период
  // тоже искался обычным ILIKE, а не только точным/диапазонным сравнением дат.
  // period здесь всегда заполнен (не как birthDate у Individual), поэтому не String? —
  // dbgenerated("") ничего не меняет в реальной БД (та задаётся ручной миграцией),
  // но помечает поле как "с дефолтом", чтобы Prisma не требовал его при createMany.
  periodText  String   @default(dbgenerated()) @map("period_text")
  country     String
  countryCode String   @map("country_code")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([fizicheskoyeLitsoUid])
  @@map("citizenships")
}

// Тот же принцип "слепка", что и Citizenship — история паспортных данных без
// стабильного ключа (несколько документов на одно физлицо со временем), полная
// очистка+перезапись при каждом запуске. ФИО не хранится, только связь с Individual.
model Passport {
  id                   Int        @id @default(autoincrement())
  fizicheskoyeLitsoUid String     @map("fizicheskoye_litso_uid")
  individual           Individual @relation(fields: [fizicheskoyeLitsoUid], references: [fizicheskoyeLitsoUid])

  period        DateTime
  periodText    String   @default(dbgenerated()) @map("period_text")
  type          String
  series        String
  number        String
  dateStart     DateTime @map("date_start")
  dateStartText String   @default(dbgenerated()) @map("date_start_text")
  unit          String
  codeUnit      String   @map("code_unit")
  systemDoc     String   @map("system_doc")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([fizicheskoyeLitsoUid])
  @@map("passports")
}

// Тот же принцип "слепка" — контактов (адреса/телефоны/email/место рождения и т.д.)
// у одного физлица может быть много, стабильного ключа нет, полная очистка+перезапись
// при каждом запуске. XML/JSON — дубли Predstavleniye/Country/... в структурированном
// виде из источника; по явной просьбе храним и показываем как есть, а не отбрасываем.
model ContactInfo {
  id                   Int        @id @default(autoincrement())
  fizicheskoyeLitsoUid String     @map("fizicheskoye_litso_uid")
  individual           Individual @relation(fields: [fizicheskoyeLitsoUid], references: [fizicheskoyeLitsoUid])

  type              String
  predstavleniye    String
  xml               String
  json              String
  country           String
  region            String
  city              String
  email             String
  phoneNumber       String   @map("phone_number")
  phoneNumberNoCode String   @map("phone_number_no_code")
  // 1С отдаёт "0001-01-01" как "дата не задана" (не NULL) — храним как есть, на фронте
  // такое значение показываем как "—" (см. ContactInfo.vue).
  dateStart         DateTime @map("date_start")
  dateStartText     String   @default(dbgenerated()) @map("date_start_text")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([fizicheskoyeLitsoUid])
  @@map("contact_infos")
}

// Привязка SSO-аккаунтов (rosnou-id/Azure) к физлицам — источник legacy БД (users +
// users_binds), разово импортирована по выгрузке в JSON, только строки, у которых
// univerId реально указывает на существующего физлица (см. импорт-скрипт, в репозитории
// не хранится — разовый прогон, не постоянный синхрон). id — не autoincrement, а
// исходный id аккаунта из источника (тот же id, что rosnou-id отдаёт в /api/user), как и
// у Individual сохраняем внешний идентификатор как есть. Синхрона/логов для этой таблицы
// пока нет, только сама таблица и разовый импорт — расширять по отдельной задаче.
model User {
  id       Int     @id
  bindId   String? @map("bind_id")
  azureId  String? @map("azure_id")
  univerId String? @map("univer_id")
  fullName String  @map("full_name")

  individual Individual? @relation(fields: [univerId], references: [fizicheskoyeLitsoUid], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([univerId])
  @@map("users")
}

// Однорядный лок на время выполнения синхронизации данного типа — защита от параллельного запуска.
// Уникальность type делает acquire атомарным на уровне БД (create падает, если лок уже держит кто-то другой).
model SyncLock {
  type      String   @id
  startedAt DateTime @default(now()) @map("started_at")

  @@map("sync_locks")
}

model SyncLog {
  id           Int         @id @default(autoincrement())
  type         String      @default("students")
  trigger      SyncTrigger
  status       SyncStatus
  startedAt    DateTime    @default(now()) @map("started_at")
  finishedAt   DateTime?   @map("finished_at")
  fetchedCount Int?        @map("fetched_count")
  added        Int?
  updated      Int?
  removed      Int?
  errorMessage String?     @map("error_message")
  errorStack   String?     @map("error_stack")
  // UID физлица — заполняется только для точечной синхронизации одного физлица
  // (с его карточки), у остальных 5 типов синхронов всегда null.
  targetUid    String?     @map("target_uid")
  // Разбивка added/updated/removed по шагам (студент/физлицо/гражданство/паспорт/
  // контакты) — только у точечной синхронизации физлица и только при успехе
  // (см. IndividualSyncService), у остальных 5 типов синхронов всегда null.
  details      Json?

  @@index([type, status, finishedAt])
  @@map("sync_logs")
}

enum SyncTrigger {
  CRON
  MANUAL
}

enum SyncStatus {
  RUNNING
  SUCCESS
  FAILED
}

// Справочник комнат — изначально разовая загрузка из выгрузки 1С (см. миграцию add_rooms),
// теперь дополняется вручную через UI (создание/переименование/удаление комнаты), поэтому
// guid — nullable: у комнат, заведённых на сайте, 1С-идентификатора нет и не будет.
// Этаж больше не отдельная колонка — раньше выводился регуляркой из номера (see миграция
// add_room_characteristics), теперь это обычная защищённая характеристика (см.
// RoomCharacteristicDefinition), задаётся вручную при создании комнаты (миграция
// floor_as_characteristic переносит старые значения и убирает generated-колонку).
model Room {
  id   Int     @id @default(autoincrement())
  guid String? @unique
  room String

  characteristicValues RoomCharacteristicValue[]

  @@map("rooms")
}

enum RoomCharacteristicValueType {
  BOOLEAN
  NUMBER
  TEXT
}

// Открытый каталог характеристик комнат — в отличие от floor/room, которые фиксированы,
// сотрудники заводят/переименовывают/удаляют характеристики сами через UI (см. обсуждение:
// "Жилое помещение", "Количество мест", "Площадь", "Стоимость" — стартовый набор из 1С-выгрузки,
// "Санузел" и всё, что появится дальше — уже полностью ручное). valueType закрепляет, в какую
// из типизированных колонок RoomCharacteristicValue пишется значение этой характеристики.
model RoomCharacteristicDefinition {
  id        Int                          @id @default(autoincrement())
  name      String                       @unique
  valueType RoomCharacteristicValueType  @map("value_type")
  unit      String?
  // Стартовые 4 характеристики из 1С-выгрузки (Жилое помещение/Количество мест/Площадь/
  // Стоимость) — их нельзя удалить через UI, в отличие от всего, что заводят сотрудники
  // сами (см. room-characteristic-definitions.controller.ts). Переименовывать/менять
  // единицу измерения по-прежнему можно — блокируется только delete.
  isProtected Boolean @default(false) @map("is_protected")
  // Ручной порядок для drag-and-drop в UI — новые характеристики получают
  // max(sortOrder)+1 (в конец списка), см. room-characteristic-definitions.controller.ts.
  sortOrder Int @default(0) @map("sort_order")

  values RoomCharacteristicValue[]

  createdAt DateTime @default(now()) @map("created_at")

  @@map("room_characteristic_definitions")
}

// Значение характеристики комнаты на конкретную дату — история хранится как есть (не
// перетирается), "актуальное" значение — просто ряд с максимальным period на пару
// (room, definition), см. current-characteristics.ts (тот же принцип, что pickLatestContactInfo
// у физлиц, только без эвристик — period здесь всегда надёжен, не 1С-сентинел).
// Типизированный EAV: заполнена ровно одна из трёх value*-колонок — какая именно, определяет
// definition.valueType (не дублируется на каждой записи, чтобы не могло рассинхронизироваться).
model RoomCharacteristicValue {
  id           Int                          @id @default(autoincrement())
  roomId       Int                          @map("room_id")
  room         Room                         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  definitionId Int                          @map("definition_id")
  definition   RoomCharacteristicDefinition @relation(fields: [definitionId], references: [id])
  period       DateTime

  valueBool   Boolean? @map("value_bool")
  valueNumber Decimal? @map("value_number") @db.Decimal(12, 2)
  valueText   String?  @map("value_text")
  // Исторические значения на 01.09.2026 (стартовая выгрузка 1С) — заблокированы от
  // изменения/удаления через UI навсегда, в отличие от значений, которые добавляют
  // сотрудники позже (см. rooms.controller.ts).
  isProtected Boolean @default(false) @map("is_protected")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([roomId, definitionId, period])
  @@index([roomId])
  @@map("room_characteristic_values")
}

// Финансовые показатели по общежитию в целом, не по конкретной комнате — компактная
// карточка при клике на корень дерева комнат (см. RoomTree.vue/Rooms.vue), не через
// обычный каталог характеристик комнат. Ровно 3 фиксированных поля, не открытый каталог,
// как у комнат — сотрудники не заводят/переименовывают/удаляют свои произвольные,
// поэтому обычные колонки, а не EAV. Singleton: ровно одна строка с id=1, общежитие одно
// (см. DormitoryInfoController — upsert по этому id на каждом чтении/записи). Только
// текущее значение, без истории по period — по прямой просьбе, в отличие от комнат.
model DormitoryInfo {
  id                   Int      @id @default(1)
  communalServicesCost Decimal? @map("communal_services_cost") @db.Decimal(12, 2)
  dailyPaymentInternal Decimal? @map("daily_payment_internal") @db.Decimal(12, 2)
  dailyPaymentOther    Decimal? @map("daily_payment_other") @db.Decimal(12, 2)
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("dormitory_info")
}
