// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// Один активный студент = одна зачётная книжка (ZachetnayaKnigaUID из внешнего API).
// Отчисленных/выпустившихся не храним — при синхронизации отсутствующие строки удаляются.
model Student {
  zachetnayaKnigaUid   String   @map("zachetnaya_kniga_uid")
  fizicheskoyeLitsoUid String   @map("fizicheskoye_litso_uid")
  fullName             String   @map("full_name")
  zachetnayaKniga      String   @map("zachetnaya_kniga")
  uchebYear            String   @map("ucheb_year")
  uchebPlan            String   @map("ucheb_plan")
  uchebPlanOsnova      String   @map("ucheb_plan_osnova")
  formObuch            String   @map("form_obuch")
  facultet             String
  speciality           String
  kurs                 String
  kursNumber           Int      @map("kurs_number")
  group                String   @map("study_group")
  uchebStatus          String   @map("ucheb_status")
  osnovaObuch          String   @map("osnova_obuch")
  urovenPodgotov       String   @map("uroven_podgotov")
  profilSpec           String?  @map("profil_spec")
  dot                  Boolean
  facultAbbr           String   @map("facult_abbr")
  period               DateTime

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@id([zachetnayaKnigaUid, fizicheskoyeLitsoUid])
  @@index([fizicheskoyeLitsoUid])
  @@map("students")
}

// Физическое лицо (человек), в отличие от Student — не привязано к конкретной зачётке
// (у одного человека может быть несколько). Источник данных отдаёт их по запросу с
// конкретными UID, а не полным списком, поэтому здесь никогда не делаем hard delete —
// пропавшая или помеченная DeleteMark=true запись всё равно остаётся в базе как есть.
// Только fullName обязателен. Синхрон из 1С заполняет все остальные поля всегда,
// но будущее ручное добавление на сайте (см. isManual) может завести человека
// сначала по одному имени, остальное — позже, поэтому у таблицы не может быть NOT NULL
// на всём подряд.
model Individual {
  fizicheskoyeLitsoUid String    @id @map("fizicheskoye_litso_uid")
  deleteMark           Boolean   @default(false) @map("delete_mark")
  code                 String?
  fullName             String    @map("full_name")
  surname              String?
  name                 String?
  otchestvo            String?
  gender               String?
  birthDate            DateTime? @map("birth_date")
  // Сгенерированная БД колонка (to_char(birth_date, 'DD.MM.YYYY')) — только чтобы дату
  // рождения можно было искать тем же ILIKE-поиском по тексту, что и остальные поля,
  // не переписывая весь список на сырой SQL. Приложение в неё никогда не пишет.
  birthDateText        String?   @map("birth_date_text")
  inn                  String?
  snils                String?
  photoCode            String?   @map("photo_code")
  // Заведено вручную на сайте, а не синхроном из 1С — такие записи синхрон физлиц
  // не трогает и их UID не участвует в запросе к источнику (см. individuals-sync.service.ts).
  isManual             Boolean   @default(false) @map("is_manual")

  // Поля ручного ввода (форма "Новое физическое лицо", individuals.controller.ts, и
  // родитель несовершеннолетнего при создании договора, contracts.controller.ts) — для
  // синхронизируемых из 1С физлиц всегда null, реальные контакты/документы там приходят
  // через связи contactInfos/passports. Не путать с Passport/ContactInfo — те две модели
  // "слепок из 1С" с обязательными техническими полями (xml/json/systemDoc и т.п.), не
  // подходящими для ручного ввода.
  phone                String?   @map("phone")
  email                String?   @map("email")
  address              String?   @map("address")
  passportSeries       String?   @map("passport_series")
  passportNumber       String?   @map("passport_number")
  passportIssuedBy     String?   @map("passport_issued_by")
  passportIssuedCode   String?   @map("passport_issued_code")
  passportIssuedAt     DateTime? @map("passport_issued_at")
  // Гражданство ручного ввода — как и остальные поля выше, только для isManual; у
  // синхронизируемых физлиц гражданство приходит через связь citizenships (история по period).
  citizenship          String?   @map("citizenship")

  citizenships Citizenship[]
  passports    Passport[]
  contactInfos ContactInfo[]
  users        User[]
  contracts    Contract[]
  contractsAsLegalRep Contract[] @relation("ContractLegalRep")
  chatConversation ChatConversation?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("individuals")
}

// "Слепок", а не синхрон в смысле Student/Individual — источник отдаёт историю
// гражданств без какого-либо стабильного ключа (у одного физлица может быть
// несколько периодов), апсертить не по чему. Поэтому при каждом запуске таблица
// полностью очищается и заполняется заново (как раньше делали для Student).
// ФИО в этой таблице не хранится — только fizicheskoyeLitsoUid, ФИО подтягивается
// связью с Individual на чтении (см. citizenship.controller.ts).
model Citizenship {
  id                   Int        @id @default(autoincrement())
  fizicheskoyeLitsoUid String     @map("fizicheskoye_litso_uid")
  individual           Individual @relation(fields: [fizicheskoyeLitsoUid], references: [fizicheskoyeLitsoUid])

  period      DateTime
  // Сгенерированная БД колонка (см. birthDateText у Individual) — чтобы период
  // тоже искался обычным ILIKE, а не только точным/диапазонным сравнением дат.
  // period здесь всегда заполнен (не как birthDate у Individual), поэтому не String? —
  // dbgenerated("") ничего не меняет в реальной БД (та задаётся ручной миграцией),
  // но помечает поле как "с дефолтом", чтобы Prisma не требовал его при createMany.
  periodText  String   @default(dbgenerated()) @map("period_text")
  country     String
  countryCode String   @map("country_code")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([fizicheskoyeLitsoUid])
  @@map("citizenships")
}

// Тот же принцип "слепка", что и Citizenship — история паспортных данных без
// стабильного ключа (несколько документов на одно физлицо со временем), полная
// очистка+перезапись при каждом запуске. ФИО не хранится, только связь с Individual.
model Passport {
  id                   Int        @id @default(autoincrement())
  fizicheskoyeLitsoUid String     @map("fizicheskoye_litso_uid")
  individual           Individual @relation(fields: [fizicheskoyeLitsoUid], references: [fizicheskoyeLitsoUid])

  period        DateTime
  periodText    String   @default(dbgenerated()) @map("period_text")
  type          String
  series        String
  number        String
  dateStart     DateTime @map("date_start")
  dateStartText String   @default(dbgenerated()) @map("date_start_text")
  unit          String
  codeUnit      String   @map("code_unit")
  systemDoc     String   @map("system_doc")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([fizicheskoyeLitsoUid])
  @@map("passports")
}

// Тот же принцип "слепка" — контактов (адреса/телефоны/email/место рождения и т.д.)
// у одного физлица может быть много, стабильного ключа нет, полная очистка+перезапись
// при каждом запуске. XML/JSON — дубли Predstavleniye/Country/... в структурированном
// виде из источника; по явной просьбе храним и показываем как есть, а не отбрасываем.
model ContactInfo {
  id                   Int        @id @default(autoincrement())
  fizicheskoyeLitsoUid String     @map("fizicheskoye_litso_uid")
  individual           Individual @relation(fields: [fizicheskoyeLitsoUid], references: [fizicheskoyeLitsoUid])

  type              String
  predstavleniye    String
  xml               String
  json              String
  country           String
  region            String
  city              String
  email             String
  phoneNumber       String   @map("phone_number")
  phoneNumberNoCode String   @map("phone_number_no_code")
  // 1С отдаёт "0001-01-01" как "дата не задана" (не NULL) — храним как есть, на фронте
  // такое значение показываем как "—" (см. ContactInfo.vue).
  dateStart         DateTime @map("date_start")
  dateStartText     String   @default(dbgenerated()) @map("date_start_text")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([fizicheskoyeLitsoUid])
  @@map("contact_infos")
}

// Привязка SSO-аккаунтов (rosnou-id/Azure) к физлицам — источник legacy БД (users +
// users_binds), разово импортирована по выгрузке в JSON, только строки, у которых
// univerId реально указывает на существующего физлица (см. импорт-скрипт, в репозитории
// не хранится — разовый прогон, не постоянный синхрон). id — не autoincrement, а
// исходный id аккаунта из источника (тот же id, что rosnou-id отдаёт в /api/user), как и
// у Individual сохраняем внешний идентификатор как есть. Синхрона/логов для этой таблицы
// пока нет, только сама таблица и разовый импорт — расширять по отдельной задаче.
model User {
  id       Int     @id
  bindId   String? @map("bind_id")
  azureId  String? @map("azure_id")
  univerId String? @map("univer_id")
  fullName String  @map("full_name")
  // Заполняется/обновляется автоматически при каждом логине из фолбека rosnou-id
  // (SessionUser.email, см. auth.controller.ts) — не из формы, своего UI на это поле нет.
  email    String?

  individual Individual? @relation(fields: [univerId], references: [fizicheskoyeLitsoUid], onDelete: SetNull)

  contractsCreated Contract[] @relation("ContractCreatedBy")
  paymentsCreated  Payment[]  @relation("PaymentCreatedBy")
  roles            UserRole[]
  auditLogs        AuditLog[]
  chatMessages     ChatMessage[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([univerId])
  @@map("users")
}

// История изменений (кто/что/где поменял) — только действия живых пользователей через UI,
// не автоматические перезаписи ночным синхроном 1С (у того свой SyncLog, см. sync/). Пишется
// явными вызовами AuditLogService.log() из контроллеров (не общий Prisma-хук — иначе не
// вышло бы отличить "человек нажал кнопку" от синхрона, и сообщения были бы менее читаемыми).
// changes — diff только по интересующим полям на момент действия (не весь объект целиком) —
// { fieldName: { before, after } }, для CREATE/DELETE одна из сторон всегда null.
model AuditLog {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  action      String
  // Тип сущности — своё короткое имя ('Individual'/'Contract'/'Room' и т.п.), не Prisma
  // model name напрямую, чтобы не сломаться при переименовании модели в схеме.
  entityType  String
  // Строкой всегда, даже если реальный PK — число (Contract.id) или natural key
  // (Individual.fizicheskoyeLitsoUid) — единое поле для фильтра/ссылки в UI.
  entityId    String
  // Человекочитаемая метка сущности НА МОМЕНТ действия (ФИО/номер договора и т.п.) — сама
  // сущность могла быть с тех пор переименована или удалена, а запись истории должна
  // остаться понятной.
  entityLabel String
  changes     Json
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

// Первая часть ролевой модели (первый этап, см. промпт проекта) — только таблицы и
// назначение по 3 фиксированным ролям, БЕЗ своего UI управления (это отдельная,
// пока не начатая задача) и БЕЗ бэкенд-проверки на большинстве эндпоинтов (только
// individuals/contracts, см. @Roles() там) — известная критическая дыра (AuthGuard
// без проверки роли) остаётся открытой почти everywhere ещё на один заход.
// name — стабильный ключ ('ADMIN'/'STAFF'/'RESIDENT'), не для отображения (русские
// подписи — в коде, ROLE_LABELS, тот же принцип, что statusLabel/BUCKET_LABELS).
model Role {
  id    Int        @id @default(autoincrement())
  name  String     @unique
  users UserRole[]

  @@map("roles")
}

// Junction, не enum-колонка на User — по прямой просьбе, плюс задел на будущее
// (несколько ролей на аккаунт), даже если сейчас практически используется одна.
model UserRole {
  userId Int @map("user_id")
  roleId Int @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("users_roles")
}

// Однорядный лок на время выполнения синхронизации данного типа — защита от параллельного запуска.
// Уникальность type делает acquire атомарным на уровне БД (create падает, если лок уже держит кто-то другой).
model SyncLock {
  type      String   @id
  startedAt DateTime @default(now()) @map("started_at")

  @@map("sync_locks")
}

model SyncLog {
  id           Int         @id @default(autoincrement())
  type         String      @default("students")
  trigger      SyncTrigger
  status       SyncStatus
  startedAt    DateTime    @default(now()) @map("started_at")
  finishedAt   DateTime?   @map("finished_at")
  fetchedCount Int?        @map("fetched_count")
  added        Int?
  updated      Int?
  removed      Int?
  errorMessage String?     @map("error_message")
  errorStack   String?     @map("error_stack")
  // UID физлица — заполняется только для точечной синхронизации одного физлица
  // (с его карточки), у остальных 5 типов синхронов всегда null.
  targetUid    String?     @map("target_uid")
  // Разбивка added/updated/removed по шагам (студент/физлицо/гражданство/паспорт/
  // контакты) — только у точечной синхронизации физлица и только при успехе
  // (см. IndividualSyncService), у остальных 5 типов синхронов всегда null.
  details      Json?

  @@index([type, status, finishedAt])
  @@map("sync_logs")
}

enum SyncTrigger {
  CRON
  MANUAL
}

enum SyncStatus {
  RUNNING
  SUCCESS
  FAILED
}

// Справочник комнат — изначально разовая загрузка из выгрузки 1С (см. миграцию add_rooms),
// теперь дополняется вручную через UI (создание/переименование/удаление комнаты), поэтому
// guid — nullable: у комнат, заведённых на сайте, 1С-идентификатора нет и не будет.
// Этаж больше не отдельная колонка — раньше выводился регуляркой из номера (see миграция
// add_room_characteristics), теперь это обычная защищённая характеристика (см.
// RoomCharacteristicDefinition), задаётся вручную при создании комнаты (миграция
// floor_as_characteristic переносит старые значения и убирает generated-колонку).
model Room {
  id   Int     @id @default(autoincrement())
  guid String? @unique
  room String

  characteristicValues RoomCharacteristicValue[]
  roomAssignments      RoomAssignment[]

  @@map("rooms")
}

enum RoomCharacteristicValueType {
  BOOLEAN
  NUMBER
  TEXT
}

// Открытый каталог характеристик комнат — в отличие от floor/room, которые фиксированы,
// сотрудники заводят/переименовывают/удаляют характеристики сами через UI (см. обсуждение:
// "Жилое помещение", "Количество мест", "Площадь", "Стоимость" — стартовый набор из 1С-выгрузки,
// "Санузел" и всё, что появится дальше — уже полностью ручное). valueType закрепляет, в какую
// из типизированных колонок RoomCharacteristicValue пишется значение этой характеристики.
model RoomCharacteristicDefinition {
  id        Int                          @id @default(autoincrement())
  name      String                       @unique
  valueType RoomCharacteristicValueType  @map("value_type")
  unit      String?
  // Стартовые 4 характеристики из 1С-выгрузки (Жилое помещение/Количество мест/Площадь/
  // Стоимость) — их нельзя удалить через UI, в отличие от всего, что заводят сотрудники
  // сами (см. room-characteristic-definitions.controller.ts). Переименовывать/менять
  // единицу измерения по-прежнему можно — блокируется только delete.
  isProtected Boolean @default(false) @map("is_protected")
  // Ручной порядок для drag-and-drop в UI — новые характеристики получают
  // max(sortOrder)+1 (в конец списка), см. room-characteristic-definitions.controller.ts.
  sortOrder Int @default(0) @map("sort_order")

  values RoomCharacteristicValue[]

  createdAt DateTime @default(now()) @map("created_at")

  @@map("room_characteristic_definitions")
}

// Значение характеристики комнаты на конкретную дату — история хранится как есть (не
// перетирается), "актуальное" значение — просто ряд с максимальным period на пару
// (room, definition), см. current-characteristics.ts (тот же принцип, что pickLatestContactInfo
// у физлиц, только без эвристик — period здесь всегда надёжен, не 1С-сентинел).
// Типизированный EAV: заполнена ровно одна из трёх value*-колонок — какая именно, определяет
// definition.valueType (не дублируется на каждой записи, чтобы не могло рассинхронизироваться).
model RoomCharacteristicValue {
  id           Int                          @id @default(autoincrement())
  roomId       Int                          @map("room_id")
  room         Room                         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  definitionId Int                          @map("definition_id")
  definition   RoomCharacteristicDefinition @relation(fields: [definitionId], references: [id])
  period       DateTime

  valueBool   Boolean? @map("value_bool")
  valueNumber Decimal? @map("value_number") @db.Decimal(12, 2)
  valueText   String?  @map("value_text")
  // Исторические значения на 01.09.2026 (стартовая выгрузка 1С) — заблокированы от
  // изменения/удаления через UI навсегда, в отличие от значений, которые добавляют
  // сотрудники позже (см. rooms.controller.ts).
  isProtected Boolean @default(false) @map("is_protected")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([roomId, definitionId, period])
  @@index([roomId])
  @@map("room_characteristic_values")
}

// Финансовые показатели по общежитию в целом, не по конкретной комнате — компактная
// карточка при клике на корень дерева комнат (см. RoomTree.vue/Rooms.vue), не через
// обычный каталог характеристик комнат. Ровно 3 фиксированных поля, не открытый каталог,
// как у комнат — сотрудники не заводят/переименовывают/удаляют свои произвольные,
// поэтому обычные колонки, а не EAV. Singleton: ровно одна строка с id=1, общежитие одно
// (см. DormitoryInfoController — upsert по этому id на каждом чтении/записи). Только
// текущее значение, без истории по period — по прямой просьбе, в отличие от комнат.
model DormitoryInfo {
  id                   Int      @id @default(1)
  communalServicesCost Decimal? @map("communal_services_cost") @db.Decimal(12, 2)
  dailyPaymentInternal Decimal? @map("daily_payment_internal") @db.Decimal(12, 2)
  dailyPaymentOther    Decimal? @map("daily_payment_other") @db.Decimal(12, 2)
  // Добавлено 2026-08-23 — справочные величины для страницы "Проживающий → Общая
  // информация" (StudentGeneralInfo.vue): восстановление утерянного пропускного
  // документа (единая цена что для студенческого билета, что для пластиковой карты)
  // и суточная ставка для гостевых комнат (см. характеристика "Гостевая" ниже).
  passRestorationCost Decimal? @map("pass_restoration_cost") @db.Decimal(12, 2)
  guestRoomDailyRate  Decimal? @map("guest_room_daily_rate") @db.Decimal(12, 2)
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("dormitory_info")
}

// ===== Договоры найма, начисления, оплаты =====
// Начисления и оплаты — раздельные потоки данных (AR-леджер), не "остаток на договоре":
// долг — не хранимое поле, а производная (начислено − оплачено), см. Accrual/Payment ниже.

enum ContractStatus {
  ACTIVE
  TERMINATED
  EXPIRED
}

enum DailyRateCategory {
  OWN_UNIVERSITY
  OTHER_UNIVERSITY
}

// Договор найма — сам факт и стороны. Финансовые условия — не здесь, а в ContractTerms
// (могут пересматриваться в течение срока), комната — не здесь, а в RoomAssignment
// (переезд между комнатами не должен рвать договор и терять историю "кто где жил на дату
// X"). residentIndividualUid — всегда проживающий (чья зачётка, кто физически живёт), не
// родитель. Для несовершеннолетних Наниматель — родитель, который как правило никогда не
// появится в 1С и не должен заводиться как Individual(isManual) — это сделало бы isManual
// нормой для целой категории договоров вместо редкого служебного случая, поэтому родитель
// хранится простыми полями прямо здесь, не отдельной сущностью.
model Contract {
  id                    Int            @id @default(autoincrement())
  number                String
  contractDate          DateTime       @map("contract_date")
  residentIndividualUid String         @map("resident_individual_uid")
  resident              Individual     @relation(fields: [residentIndividualUid], references: [fizicheskoyeLitsoUid])
  startDate             DateTime       @map("start_date")
  endDate               DateTime       @map("end_date")
  // Фактическая дата выезда, если раньше endDate (досрочное расторжение) — endDate при
  // этом не переписывается, исходные условия договора не теряются.
  actualEndDate         DateTime?      @map("actual_end_date")
  status                ContractStatus @default(ACTIVE)

  // Причина проживания для тех, кто не из АНО ВО «РосНОУ» (dailyRateCategory ==
  // OTHER_UNIVERSITY) — печатается в п.1.2 бланка вместо стандартной формулировки
  // "обучением в АНО ВО «РосНОУ»". Для своих студентов не используется (null).
  residenceReason String? @map("residence_reason")

  // Родитель/законный представитель — у взрослых заполнен только legalRepPhone (просто
  // контакт по тексту договора), у несовершеннолетних весь блок (родитель — сторона
  // договора, паспортные данные обязательны).
  legalRepName             String?   @map("legal_rep_name")
  legalRepPhone             String?   @map("legal_rep_phone")
  legalRepGender            String?   @map("legal_rep_gender")
  legalRepBirthDate         DateTime? @map("legal_rep_birth_date")
  legalRepPassportSeries    String?   @map("legal_rep_passport_series")
  legalRepPassportNumber    String?   @map("legal_rep_passport_number")
  legalRepPassportIssuedBy  String?   @map("legal_rep_passport_issued_by")
  legalRepPassportIssuedCode String?  @map("legal_rep_passport_issued_code")
  legalRepPassportIssuedAt  DateTime? @map("legal_rep_passport_issued_at")
  legalRepSnils             String?   @map("legal_rep_snils")
  legalRepInn               String?   @map("legal_rep_inn")
  legalRepAddress           String?   @map("legal_rep_address")

  // Оплата материнским капиталом — единовременный платёж за явно заданный период с
  // возможной отсрочкой (ПФР платит не сразу). Если период попадает под неё, крон пени
  // (см. Accrual) не начисляет пеню, пока текущая дата <= matCapitalDeferredUntil.
  // matCapitalAmount — справочно (сумма к получению от ПФР), в леджер начислений/оплат
  // не заводится напрямую, реальная оплата по-прежнему через обычный Payment.
  matCapitalCoveredFrom   DateTime? @map("mat_capital_covered_from")
  matCapitalCoveredTo     DateTime? @map("mat_capital_covered_to")
  matCapitalAmount        Decimal?  @map("mat_capital_amount") @db.Decimal(12, 2)
  matCapitalDeferredUntil DateTime? @map("mat_capital_deferred_until")

  // Пеня — 0,14%/день от суммы всех ПРОСРОЧЕННЫХ (прошёл срок 10-го числа месяца,
  // следующего за periodStart, см. accrual-generation.ts/penaltyStartsAt) и непогашенных
  // начислений — начисляется ночным кроном (billing/penalty.scheduler.ts). Сама сумма НЕ
  // хранится отдельным полем (по прямой просьбе 2026-08-22 — нужен отчёт "на дату", а
  // одно число без истории по дням не даёт восстановить пеню на прошлую дату) — она
  // производная: сумма PenaltyAccrualLog.amount по этому договору за нужный период,
  // см. billing/penalty-balance.ts. penaltyAccruedThrough — до какой даты уже начислено,
  // только для идемпотентности крона, сам баланс из него не считать.
  penaltyAccruedThrough DateTime? @map("penalty_accrued_through")
  penaltyLogs            PenaltyAccrualLog[]

  // Снимок личных данных проживающего на момент подписания (паспорт/СНИЛС/адрес/телефон/
  // институт-курс — то, что синхрон 1С может незаметно перезаписать позже). Заполняется
  // один раз при создании договора; для договоров, созданных до этой фичи — лениво при
  // первой печати (см. resident-snapshot.ts) и дальше уже не трогается.
  residentSnapshot Json? @map("resident_snapshot")

  // Родитель несовершеннолетнего как отдельный Individual(isManual=true) — только чтобы на
  // следующем договоре того же несовершеннолетнего подставить уже введённые данные.
  // Печатные данные конкретно ЭТОГО договора по-прежнему берутся из legalRep*-полей выше
  // (они не меняются задним числом) — эта связь не источник печати, а только для автоподстановки.
  legalRepIndividualUid String?     @map("legal_rep_individual_uid")
  legalRepIndividual    Individual? @relation("ContractLegalRep", fields: [legalRepIndividualUid], references: [fizicheskoyeLitsoUid])

  // Необязательная связь для истории перезаключений — на бизнес-логику начислений не
  // влияет, продление всегда новый Contract с новым номером и датами, не мутация старого.
  renewedFromContractId Int?       @map("renewed_from_contract_id")
  renewedFrom           Contract?  @relation("ContractRenewal", fields: [renewedFromContractId], references: [id])
  renewals               Contract[] @relation("ContractRenewal")

  createdByUserId Int?  @map("created_by_user_id")
  createdBy       User? @relation("ContractCreatedBy", fields: [createdByUserId], references: [id])

  terms                ContractTerms[]
  roomAssignments      RoomAssignment[]
  accruals             Accrual[]
  payments             Payment[]
  paymentImportRecords PaymentImportRecord[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([number])
  @@index([residentIndividualUid])
  @@index([status])
  @@map("contracts")
}

// Финансовые условия договора — снимок на момент подписания/пересмотра, с историей (тот
// же принцип, что у RoomCharacteristicValue: "текущее" = запись с максимальным validFrom).
// Не мутируем существующую строку при пересмотре цены — закрываем validTo у старой,
// создаём новую, чтобы уже сформированные начисления оставались объяснимыми задним числом.
model ContractTerms {
  id         Int       @id @default(autoincrement())
  contractId Int       @map("contract_id")
  contract   Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  validFrom  DateTime  @map("valid_from")
  validTo    DateTime? @map("valid_to")

  rentAmount        Decimal           @map("rent_amount") @db.Decimal(12, 2)
  utilitiesAmount   Decimal           @map("utilities_amount") @db.Decimal(12, 2)
  dailyRateCategory DailyRateCategory @map("daily_rate_category")
  dailyRateAmount   Decimal           @map("daily_rate_amount") @db.Decimal(12, 2)
  // Число месяца, до которого нужно оплатить конкретное месячное начисление (п. 4.4/5.4
  // договора — всегда 5, но не хардкодим). Наниматель платит как ему удобно, не привязан
  // к единой схеме на весь срок — это только срок начисления, не выбор периодичности.
  paymentDueDay Int @default(5) @map("payment_due_day")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([contractId, validFrom])
  @@map("contract_terms")
}

// История заселения в комнату — отдельно от финансовых условий, потому что переезд между
// комнатами не меняет юридические условия найма, только помещение, и не должен рвать
// договор или терять историю "кто где жил на дату X". Текущая комната = запись с toDate = null.
model RoomAssignment {
  id         Int       @id @default(autoincrement())
  contractId Int       @map("contract_id")
  contract   Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  roomId     Int       @map("room_id")
  room       Room      @relation(fields: [roomId], references: [id])
  fromDate   DateTime  @map("from_date")
  toDate     DateTime? @map("to_date")
  reason     String?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([contractId, fromDate])
  @@index([roomId, fromDate])
  @@map("room_assignments")
}

// Начисление — одна строка на один расчётный период (обычно календарный месяц, кроме
// первого/последнего — они могут быть неполными и считаются посуточно по dailyRateAmount
// из действовавших на periodStart ContractTerms, с потолком в полную месячную сумму,
// см. п. 4.2/5.2 договора). totalAmount/остаток не хранятся отдельным полем — считаются
// на чтении (rentAmount + utilitiesAmount + adjustmentAmount минус сумма PaymentAllocation),
// материализация в кеш — только если реально понадобится по нагрузке. Пеня — НЕ здесь,
// она единая на весь договор и по дням, см. PenaltyAccrualLog ниже (по прямой просьбе
// 2026-08-22: база пени — сумма всех просроченных начислений договора целиком, не одно
// начисление).
model Accrual {
  id         Int      @id @default(autoincrement())
  contractId Int      @map("contract_id")
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  periodStart DateTime @map("period_start")
  periodEnd   DateTime @map("period_end")
  dueDate     DateTime @map("due_date")

  rentAmount      Decimal @map("rent_amount") @db.Decimal(12, 2)
  utilitiesAmount Decimal @map("utilities_amount") @db.Decimal(12, 2)

  // Ручная корректировка (плюс или минус) поверх исходно выставленной суммы — например,
  // пересчёт последнего периода при досрочном выезде. Не переписываем rentAmount/
  // utilitiesAmount напрямую, чтобы не терять то, что реально было выставлено человеку.
  adjustmentAmount Decimal @default(0) @map("adjustment_amount") @db.Decimal(12, 2)
  adjustmentReason String? @map("adjustment_reason")

  // Начисление отменено (период стал ненужным при досрочном расторжении) — не удаляем
  // физически, помечаем, чтобы не терять историю того, что вообще планировалось.
  voidedAt DateTime? @map("voided_at")

  allocations PaymentAllocation[]

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([contractId, periodStart, periodEnd])
  @@index([dueDate])
  @@map("accruals")
}

// Журнал начисления пени — одна строка на один календарный день на один договор,
// пишется ночным кроном (billing/penalty.scheduler.ts). Это не только аудит ("откуда
// взялась сумма") — это ЕДИНСТВЕННЫЙ источник самой суммы пени: Contract больше не хранит
// пеню отдельным полем, она всегда считается как SUM(amount) по нужному диапазону дат
// (см. billing/penalty-balance.ts), это и даёт финансовому отчёту точную пеню на
// произвольную ПРОШЛУЮ дату, а не только "на сейчас".
model PenaltyAccrualLog {
  id         Int      @id @default(autoincrement())
  contractId Int      @map("contract_id")
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  // Календарный день, за который начислена ЭТА строка (не дата запуска крона — при
  // довозе пропущенных дней одним запуском на каждый день своя строка, см. крон).
  date DateTime @map("date")
  // Добавлено пени за этот день.
  amount Decimal @db.Decimal(12, 2)
  // База расчёта (сумма просроченных непогашенных начислений на момент запуска крона),
  // справочно — amount = overdueBase * PENALTY_DAILY_RATE, хранится явно, чтобы не
  // пересчитывать вручную при разборе "откуда цифра", см. запрос пользователя 2026-08-22.
  overdueBase Decimal @map("overdue_base") @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([contractId, date])
  @@index([contractId, date])
  @@map("penalty_accrual_log")
}

enum PaymentMethod {
  CASH
  CARD_ACQUIRING
  BANK_TRANSFER
  MAT_CAPITAL
  WEBSITE
}

enum PaymentSource {
  MANUAL
  IMPORTED_1C
  WEBSITE
}

// Платёж — факт поступления денег. contractId обязателен (в отличие от черновой идеи
// делать его nullable под неопознанные 1С-платежи) — неоднозначные платежи из импорта
// остаются в PaymentImportRecord и превращаются в Payment только после сопоставления
// с договором, поэтому в самом леджере "подвешенных" записей не бывает.
model Payment {
  id         Int      @id @default(autoincrement())
  contractId Int      @map("contract_id")
  contract   Contract @relation(fields: [contractId], references: [id])

  amount  Decimal       @db.Decimal(12, 2)
  paidAt  DateTime      @map("paid_at")
  method  PaymentMethod
  source  PaymentSource

  // id платёжного документа в 1С — для идемпотентности повторного импорта и связи с
  // PaymentImportRecord. rawComment — исходное "Назначение платежа", на случай, если
  // авто-сопоставление ошиблось и нужно разбираться руками.
  externalRef String? @map("external_ref")
  rawComment  String? @map("raw_comment")

  // Платёж отменён/сторнирован (ошибочно внесён и т.п.) — не удаляем, помечаем.
  reversedAt DateTime? @map("reversed_at")

  createdByUserId Int?  @map("created_by_user_id")
  createdBy       User? @relation("PaymentCreatedBy", fields: [createdByUserId], references: [id])

  allocations PaymentAllocation[]
  importRecord PaymentImportRecord?

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([source, externalRef])
  @@index([contractId, paidAt])
  @@map("payments")
}

// Разнесение платежа по начислениям — таблица многие-ко-многим: один платёж может
// закрыть несколько начислений (квартальная/годовая оплата разом), одно начисление может
// закрываться несколькими платежами (частичная оплата). Долг — не отдельное поле, а
// разница между Accrual.total и суммой этих строк, см. комментарий у Accrual.
model PaymentAllocation {
  id        Int     @id @default(autoincrement())
  paymentId Int     @map("payment_id")
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  accrualId Int     @map("accrual_id")
  accrual   Accrual @relation(fields: [accrualId], references: [id])

  amount Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([paymentId])
  @@index([accrualId])
  @@map("payment_allocations")
}

enum PaymentImportStatus {
  IMPORTED
  MATCHED
  NEEDS_REVIEW
  REJECTED
}

// Стадия импорта из 1С — сырые данные попадают сюда первыми, целиком (rawPayload), и
// только после однозначного сопоставления с договором (авто или вручную сотрудником)
// создаётся настоящий Payment. Так в основном леджере (Payment) никогда не оказывается
// неоднозначных/неподтверждённых записей — тот же принцип "храним сырое как есть", что
// уже применён к ContactInfo.xml/json. Импорт как таковой (сам процесс выгрузки из 1С)
// этой миграцией не реализуется — только место, куда он будет класть данные.
model PaymentImportRecord {
  id         Int                 @id @default(autoincrement())
  source     String              @default("1C")
  externalId String              @map("external_id")
  rawPayload Json                @map("raw_payload")
  importedAt DateTime            @default(now()) @map("imported_at")
  status     PaymentImportStatus @default(IMPORTED)

  matchedContractId Int?      @map("matched_contract_id")
  matchedContract   Contract? @relation(fields: [matchedContractId], references: [id])

  resultingPaymentId Int?     @unique @map("resulting_payment_id")
  resultingPayment    Payment? @relation(fields: [resultingPaymentId], references: [id])

  reviewedByUserId Int?      @map("reviewed_by_user_id")
  reviewedAt       DateTime? @map("reviewed_at")

  @@unique([source, externalId])
  @@index([status])
  @@map("payment_import_records")
}

// ===== Внутренний чат «проживающий ↔ сотрудники» =====
// Упрощённая переписка по типу Telegram, не тикет-система — без приоритетов/статусов/
// назначения ответственного (см. промпт проекта, раздел про чат). Один диалог на
// физлицо, общий сразу для всех сотрудников (нет "назначен на конкретного сотрудника").

// Диалог привязан к Individual, а не к User — так рассылка/фильтр по этажу/должникам
// может адресоваться физлицу, у которого ещё нет аккаунта rosnou-id (аккаунт и роль
// RESIDENT появляются только при первом логине, см. resident-role-sync.ts): сообщение
// уже будет ждать его в диалоге, диалог найдётся по individualUid, когда он всё же войдёт.
model ChatConversation {
  id            Int        @id @default(autoincrement())
  individualUid String     @unique @map("individual_uid")
  individual    Individual @relation(fields: [individualUid], references: [fizicheskoyeLitsoUid])

  lastMessageAt DateTime @default(now()) @map("last_message_at")
  // Общая на ВСЕХ сотрудников отметка прочтения — нет назначения ответственного, значит
  // нет и персонального прочтения: открыл один сотрудник диалог — непрочитанность
  // снимается для всей команды сразу (по прямой просьбе, см. промпт проекта).
  staffLastReadAt    DateTime? @map("staff_last_read_at")
  residentLastReadAt DateTime? @map("resident_last_read_at")

  messages ChatMessage[]

  createdAt DateTime @default(now()) @map("created_at")

  @@map("chat_conversations")
}

enum ChatSenderRole {
  RESIDENT
  STAFF
}

model ChatMessage {
  id             Int              @id @default(autoincrement())
  conversationId Int              @map("conversation_id")
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderUserId   Int              @map("sender_user_id")
  sender         User             @relation(fields: [senderUserId], references: [id])
  // Хранится явно на сообщении, а не выводится из текущих ролей отправителя — роль в
  // JWT это снимок на момент логина (не живая проверка, см. известную проблему в
  // промпте проекта), плюс гибридный аккаунт (сотрудник, который сам проживает) может
  // писать и как сотрудник, и как проживающий — это поле однозначно определяет, с какой
  // стороны экрана рисовать сообщение, независимо от смены ролей задним числом.
  senderRole ChatSenderRole @map("sender_role")

  body String

  createdAt DateTime @default(now()) @map("created_at")

  @@index([conversationId, createdAt])
  @@map("chat_messages")
}
