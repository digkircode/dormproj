

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Student {
  zachetnayaKnigaUid   String   @map("zachetnaya_kniga_uid")
  fizicheskoyeLitsoUid String   @map("fizicheskoye_litso_uid")
  fullName             String   @map("full_name")
  zachetnayaKniga      String   @map("zachetnaya_kniga")
  uchebYear            String   @map("ucheb_year")
  uchebPlan            String   @map("ucheb_plan")
  uchebPlanOsnova      String   @map("ucheb_plan_osnova")
  formObuch            String   @map("form_obuch")
  facultet             String
  speciality           String
  kurs                 String
  kursNumber           Int      @map("kurs_number")
  group                String   @map("study_group")
  uchebStatus          String   @map("ucheb_status")
  osnovaObuch          String   @map("osnova_obuch")
  urovenPodgotov       String   @map("uroven_podgotov")
  profilSpec           String?  @map("profil_spec")
  dot                  Boolean
  facultAbbr           String   @map("facult_abbr")
  period               DateTime

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@id([zachetnayaKnigaUid, fizicheskoyeLitsoUid])
  @@index([fizicheskoyeLitsoUid])
  @@index([fullName])
  @@index([group])
  @@index([kursNumber])
  @@index([facultet])
  @@index([speciality])
  @@index([formObuch])
  @@index([osnovaObuch])
  @@index([urovenPodgotov])
  @@index([profilSpec])
  @@index([dot])
  @@index([uchebYear])
  @@map("students")
}

model Individual {
  fizicheskoyeLitsoUid String    @id @map("fizicheskoye_litso_uid")
  deleteMark           Boolean   @default(false) @map("delete_mark")
  code                 String?
  fullName             String    @map("full_name")
  surname              String?
  name                 String?
  otchestvo            String?
  gender               String?
  birthDate            DateTime? @map("birth_date")
  birthDateText        String?   @map("birth_date_text")
  inn                  String?
  snils                String?
  photoCode            String?   @map("photo_code")
  isManual             Boolean   @default(false) @map("is_manual")

  phone              String?   @map("phone")
  email              String?   @map("email")
  address            String?   @map("address")
  passportSeries     String?   @map("passport_series")
  passportNumber     String?   @map("passport_number")
  passportIssuedBy   String?   @map("passport_issued_by")
  passportIssuedCode String?   @map("passport_issued_code")
  passportIssuedAt   DateTime? @map("passport_issued_at")
  citizenship        String?   @map("citizenship")

  accounting1cContractorUid String? @map("accounting_1c_contractor_uid")

  citizenships        Citizenship[]
  passports           Passport[]
  contactInfos        ContactInfo[]
  users               User[]
  contracts           Contract[]
  contractsAsLegalRep Contract[]        @relation("ContractLegalRep")
  chatConversation    ChatConversation?

  mergedIntoUid String?      @map("merged_into_uid")
  mergedInto    Individual?  @relation("IndividualMerge", fields: [mergedIntoUid], references: [fizicheskoyeLitsoUid])
  mergedFrom    Individual[] @relation("IndividualMerge")
  mergedAt      DateTime?    @map("merged_at")
  mergedSnapshot Json?       @map("merged_snapshot")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([fullName])
  @@index([code])
  @@index([snils])
  @@index([gender])
  @@index([inn])
  @@index([mergedIntoUid])
  @@map("individuals")
}

model Citizenship {
  id                   Int        @id @default(autoincrement())
  fizicheskoyeLitsoUid String     @map("fizicheskoye_litso_uid")
  individual           Individual @relation(fields: [fizicheskoyeLitsoUid], references: [fizicheskoyeLitsoUid])

  period      DateTime
  periodText  String   @default(dbgenerated()) @map("period_text")
  country     String
  countryCode String   @map("country_code")

  preservedFromMerge Boolean @default(false) @map("preserved_from_merge")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([fizicheskoyeLitsoUid])
  @@map("citizenships")
}

model Passport {
  id                   Int        @id @default(autoincrement())
  fizicheskoyeLitsoUid String     @map("fizicheskoye_litso_uid")
  individual           Individual @relation(fields: [fizicheskoyeLitsoUid], references: [fizicheskoyeLitsoUid])

  period        DateTime
  periodText    String   @default(dbgenerated()) @map("period_text")
  type          String
  series        String
  number        String
  dateStart     DateTime @map("date_start")
  dateStartText String   @default(dbgenerated()) @map("date_start_text")
  unit          String
  codeUnit      String   @map("code_unit")
  systemDoc     String   @map("system_doc")

  preservedFromMerge Boolean @default(false) @map("preserved_from_merge")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([fizicheskoyeLitsoUid])
  @@map("passports")
}

model ContactInfo {
  id                   Int        @id @default(autoincrement())
  fizicheskoyeLitsoUid String     @map("fizicheskoye_litso_uid")
  individual           Individual @relation(fields: [fizicheskoyeLitsoUid], references: [fizicheskoyeLitsoUid])

  type              String
  predstavleniye    String
  xml               String
  json              String
  country           String
  region            String
  city              String
  email             String
  phoneNumber       String   @map("phone_number")
  phoneNumberNoCode String   @map("phone_number_no_code")
  dateStart         DateTime @map("date_start")
  dateStartText     String   @default(dbgenerated()) @map("date_start_text")

  preservedFromMerge Boolean @default(false) @map("preserved_from_merge")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([fizicheskoyeLitsoUid])
  @@map("contact_infos")
}

model User {
  id       Int     @id
  bindId   String? @map("bind_id")
  azureId  String? @map("azure_id")
  univerId String? @map("univer_id")
  linkSource String @default("UNSET") @map("link_source")
  fullName String  @map("full_name")
  email    String?
  notificationLocale String @default("ru") @map("notification_locale")

  individual Individual? @relation(fields: [univerId], references: [fizicheskoyeLitsoUid], onDelete: SetNull)

  contractsCreated     Contract[]         @relation("ContractCreatedBy")
  paymentsCreated      Payment[]          @relation("PaymentCreatedBy")
  refundsCreated       ContractRefund[]   @relation("RefundCreatedBy")
  roles                UserRole[]
  auditLogs            AuditLog[]
  chatMessages         ChatMessage[]
  chatBroadcasts        ChatBroadcast[]
  announcementsCreated Announcement[]
  announcementReads    AnnouncementRead[]
  notificationLinks    NotificationLink[]
  notificationDeliveries NotificationDelivery[]
  sessions             UserSession[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([univerId])
  @@map("users")
}

model UserSession {
  id        String    @id
  userId    Int       @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  userId      Int?
  user        User?    @relation(fields: [userId], references: [id])
  action      String
  entityType  String
  entityId    String
  entityLabel String
  changes     Json
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Role {
  id    Int        @id @default(autoincrement())
  name  String     @unique
  users UserRole[]

  @@map("roles")
}

model UserRole {
  userId Int @map("user_id")
  roleId Int @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("users_roles")
}

model SyncLock {
  type      String   @id
  startedAt DateTime @default(now()) @map("started_at")

  @@map("sync_locks")
}

model SyncLog {
  id           Int         @id @default(autoincrement())
  type         String      @default("students")
  trigger      SyncTrigger
  status       SyncStatus
  startedAt    DateTime    @default(now()) @map("started_at")
  finishedAt   DateTime?   @map("finished_at")
  fetchedCount Int?        @map("fetched_count")
  added        Int?
  updated      Int?
  removed      Int?
  errorMessage String?     @map("error_message")
  errorStack   String?     @map("error_stack")
  targetUid    String?     @map("target_uid")
  details      Json?

  @@index([type, status, finishedAt])
  @@map("sync_logs")
}

enum SyncTrigger {
  CRON
  MANUAL
}

enum SyncStatus {
  RUNNING
  SUCCESS
  FAILED
}

model Room {
  id   Int     @id @default(autoincrement())
  guid String? @unique
  room String @unique

  characteristicValues RoomCharacteristicValue[]
  roomAssignments      RoomAssignment[]

  @@map("rooms")
}

enum RoomCharacteristicValueType {
  BOOLEAN
  NUMBER
  TEXT
}

model RoomCharacteristicDefinition {
  id          Int                         @id @default(autoincrement())
  name        String                      @unique
  valueType   RoomCharacteristicValueType @map("value_type")
  unit        String?
  isProtected Boolean                     @default(false) @map("is_protected")
  sortOrder   Int                         @default(0) @map("sort_order")
  options     String[]                    @default([]) @map("options")

  values RoomCharacteristicValue[]

  createdAt DateTime @default(now()) @map("created_at")

  @@map("room_characteristic_definitions")
}

model RoomCharacteristicValue {
  id           Int                          @id @default(autoincrement())
  roomId       Int                          @map("room_id")
  room         Room                         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  definitionId Int                          @map("definition_id")
  definition   RoomCharacteristicDefinition @relation(fields: [definitionId], references: [id])
  period       DateTime

  valueBool   Boolean? @map("value_bool")
  valueNumber Decimal? @map("value_number") @db.Decimal(12, 2)
  valueText   String?  @map("value_text")
  isProtected Boolean  @default(false) @map("is_protected")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([roomId, definitionId, period])
  @@index([roomId])
  @@map("room_characteristic_values")
}

model DormitoryInfo {
  id                   Int      @id @default(1)
  communalServicesCost Decimal? @map("communal_services_cost") @db.Decimal(12, 2)
  dailyPaymentInternal Decimal? @map("daily_payment_internal") @db.Decimal(12, 2)
  dailyPaymentOther    Decimal? @map("daily_payment_other") @db.Decimal(12, 2)
  passRestorationCost  Decimal? @map("pass_restoration_cost") @db.Decimal(12, 2)
  guestRoomDailyRate   Decimal? @map("guest_room_daily_rate") @db.Decimal(12, 2)
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("dormitory_info")
}


enum ContractStatus {
  ACTIVE
  EXPIRING
  OVERDUE
  COMPLETED
  TERMINATED
}

enum DailyRateCategory {
  OWN_UNIVERSITY
  OTHER_UNIVERSITY
}

model Contract {
  id                    Int            @id @default(autoincrement())
  number                String
  contractDate          DateTime       @map("contract_date")
  residentIndividualUid String         @map("resident_individual_uid")
  resident              Individual     @relation(fields: [residentIndividualUid], references: [fizicheskoyeLitsoUid])
  startDate             DateTime       @map("start_date")
  endDate               DateTime       @map("end_date")
  actualEndDate         DateTime?      @map("actual_end_date")
  status                ContractStatus @default(ACTIVE)

  residenceReason String? @map("residence_reason")

  legalRepName               String?   @map("legal_rep_name")
  legalRepPhone              String?   @map("legal_rep_phone")
  legalRepGender             String?   @map("legal_rep_gender")
  legalRepBirthDate          DateTime? @map("legal_rep_birth_date")
  legalRepPassportSeries     String?   @map("legal_rep_passport_series")
  legalRepPassportNumber     String?   @map("legal_rep_passport_number")
  legalRepPassportIssuedBy   String?   @map("legal_rep_passport_issued_by")
  legalRepPassportIssuedCode String?   @map("legal_rep_passport_issued_code")
  legalRepPassportIssuedAt   DateTime? @map("legal_rep_passport_issued_at")
  legalRepSnils              String?   @map("legal_rep_snils")
  legalRepInn                String?   @map("legal_rep_inn")
  legalRepAddress            String?   @map("legal_rep_address")

  matCapitalCoveredFrom   DateTime? @map("mat_capital_covered_from")
  matCapitalCoveredTo     DateTime? @map("mat_capital_covered_to")
  matCapitalAmount        Decimal?  @map("mat_capital_amount") @db.Decimal(12, 2)
  matCapitalDeferredUntil DateTime? @map("mat_capital_deferred_until")

  penaltyAccruedThrough DateTime?           @map("penalty_accrued_through")
  penaltyRecalcPending   Boolean             @default(false) @map("penalty_recalc_pending")
  penaltyRecalcRevision  Int                 @default(0) @map("penalty_recalc_revision")
  penaltyLogs           PenaltyAccrualLog[]

  residentSnapshot Json? @map("resident_snapshot")

  legalRepIndividualUid String?     @map("legal_rep_individual_uid")
  legalRepIndividual    Individual? @relation("ContractLegalRep", fields: [legalRepIndividualUid], references: [fizicheskoyeLitsoUid])

  renewedFromContractId Int?       @map("renewed_from_contract_id")
  renewedFrom           Contract?  @relation("ContractRenewal", fields: [renewedFromContractId], references: [id])
  renewals              Contract[] @relation("ContractRenewal")

  createdByUserId Int?  @map("created_by_user_id")
  createdBy       User? @relation("ContractCreatedBy", fields: [createdByUserId], references: [id])

  accounting1cUid String? @map("accounting_1c_uid")

  creditBalance Decimal @default(0) @map("credit_balance") @db.Decimal(12, 2)

  terms                         ContractTerms[]
  roomAssignments               RoomAssignment[]
  accruals                      Accrual[]
  payments                      Payment[]
  refunds                       ContractRefund[]
  paymentImportRecordsMatched   PaymentImportRecord[] @relation("PaymentImportMatched")
  paymentImportRecordsSuggested PaymentImportRecord[] @relation("PaymentImportSuggested")
  paymentIntents                PaymentIntent[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([number])
  @@index([residentIndividualUid])
  @@index([status])
  @@index([penaltyRecalcPending, id])
  @@map("contracts")
}

model ContractTerms {
  id         Int       @id @default(autoincrement())
  contractId Int       @map("contract_id")
  contract   Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  validFrom  DateTime  @map("valid_from")
  validTo    DateTime? @map("valid_to")

  rentAmount        Decimal           @map("rent_amount") @db.Decimal(12, 2)
  utilitiesAmount   Decimal           @map("utilities_amount") @db.Decimal(12, 2)
  dailyRateCategory DailyRateCategory @map("daily_rate_category")
  dailyRateAmount   Decimal           @map("daily_rate_amount") @db.Decimal(12, 2)
  paymentDueDay     Int               @default(5) @map("payment_due_day")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([contractId, validFrom])
  @@map("contract_terms")
}

model RoomAssignment {
  id         Int       @id @default(autoincrement())
  contractId Int       @map("contract_id")
  contract   Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  roomId     Int       @map("room_id")
  room       Room      @relation(fields: [roomId], references: [id])
  fromDate   DateTime  @map("from_date")
  toDate     DateTime? @map("to_date")
  reason     String?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([contractId, fromDate])
  @@index([roomId, fromDate])
  @@map("room_assignments")
}

model Accrual {
  id         Int      @id @default(autoincrement())
  contractId Int      @map("contract_id")
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  periodStart DateTime @map("period_start")
  periodEnd   DateTime @map("period_end")
  dueDate     DateTime @map("due_date")

  rentAmount      Decimal @map("rent_amount") @db.Decimal(12, 2)
  utilitiesAmount Decimal @map("utilities_amount") @db.Decimal(12, 2)

  adjustmentAmount Decimal @default(0) @map("adjustment_amount") @db.Decimal(12, 2)
  adjustmentReason String? @map("adjustment_reason")

  voidedAt DateTime? @map("voided_at")

  allocations PaymentAllocation[]
  refunds     ContractRefund[]

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([contractId, periodStart, periodEnd])
  @@index([dueDate])
  @@map("accruals")
}

model PenaltyAccrualLog {
  id         Int      @id @default(autoincrement())
  contractId Int      @map("contract_id")
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  date        DateTime @map("date")
  amount      Decimal  @db.Decimal(12, 2)
  overdueBase Decimal  @map("overdue_base") @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([contractId, date])
  @@index([contractId, date])
  @@index([date, contractId])
  @@map("penalty_accrual_log")
}

enum PaymentMethod {
  CASH
  CARD_ACQUIRING
  BANK_TRANSFER
  MAT_CAPITAL
  WEBSITE
}

enum PaymentSource {
  MANUAL
  IMPORTED_1C
  WEBSITE
}

enum Accounting1cSyncStatus {
  NOT_SYNCED
  SYNCED
  FAILED
}

model Payment {
  id         Int      @id @default(autoincrement())
  contractId Int      @map("contract_id")
  contract   Contract @relation(fields: [contractId], references: [id])

  amount Decimal       @db.Decimal(12, 2)
  paidAt DateTime      @map("paid_at")
  method PaymentMethod
  source PaymentSource

  penaltyAmount Decimal @default(0) @map("penalty_amount") @db.Decimal(12, 2)

  externalRef String? @map("external_ref")
  rawComment  String? @map("raw_comment")

  accounting1cSyncStatus  Accounting1cSyncStatus @default(NOT_SYNCED) @map("accounting_1c_sync_status")
  accounting1cDocumentUid String?                @map("accounting_1c_document_uid")
  accounting1cSyncError   String?                @map("accounting_1c_sync_error")
  accounting1cSyncedAt    DateTime?              @map("accounting_1c_synced_at")

  reversedAt DateTime? @map("reversed_at")

  createdByUserId Int?  @map("created_by_user_id")
  createdBy       User? @relation("PaymentCreatedBy", fields: [createdByUserId], references: [id])

  allocations   PaymentAllocation[]
  importRecord  PaymentImportRecord?
  paymentIntent PaymentIntent?

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([source, externalRef])
  @@index([contractId, paidAt])
  @@map("payments")
}

model ContractRefund {
  id               Int      @id @default(autoincrement())
  contractId       Int      @map("contract_id")
  contract         Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  accrualId        Int?     @map("accrual_id")
  accrual          Accrual? @relation(fields: [accrualId], references: [id])
  amount           Decimal  @db.Decimal(12, 2)
  creditAmount     Decimal  @default(0) @map("credit_amount") @db.Decimal(12, 2)
  adjustmentAmount Decimal @default(0) @map("adjustment_amount") @db.Decimal(12, 2)
  refundedAt       DateTime @map("refunded_at")
  comment          String?
  createdByUserId  Int      @map("created_by_user_id")
  createdBy        User     @relation("RefundCreatedBy", fields: [createdByUserId], references: [id])
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([contractId, refundedAt])
  @@index([accrualId])
  @@map("contract_refunds")
}

enum ServiceProvisionType {
  RENT
  UTILITIES
  PENALTY
}

model ServiceProvisionDocument {
  id            Int                  @id @default(autoincrement())
  periodStart   DateTime             @map("period_start")
  type          ServiceProvisionType
  documentSumm  Decimal              @db.Decimal(12, 2) @map("document_summ")
  contractCount Int                  @map("contract_count")

  accounting1cSyncStatus  Accounting1cSyncStatus @default(NOT_SYNCED) @map("accounting_1c_sync_status")
  accounting1cDocumentUid String?                @map("accounting_1c_document_uid")
  accounting1cSyncError   String?                @map("accounting_1c_sync_error")
  accounting1cSyncedAt    DateTime?              @map("accounting_1c_synced_at")

  rawPayload Json @map("raw_payload")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([periodStart, type])
  @@map("service_provision_documents")
}

model PaymentAllocation {
  id        Int     @id @default(autoincrement())
  paymentId Int     @map("payment_id")
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  accrualId Int     @map("accrual_id")
  accrual   Accrual @relation(fields: [accrualId], references: [id])

  amount Decimal @db.Decimal(12, 2)

  isPartial Boolean @default(false) @map("is_partial")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([paymentId])
  @@index([accrualId])
  @@map("payment_allocations")
}

enum PaymentImportStatus {
  MATCHED
  NEEDS_REVIEW
}

model PaymentImportRecord {
  id         Int                 @id @default(autoincrement())
  source     String              @default("1C")
  externalId String              @map("external_id")
  rawPayload Json                @map("raw_payload")
  importedAt DateTime            @default(now()) @map("imported_at")
  status     PaymentImportStatus @default(NEEDS_REVIEW)

  suggestedContractId Int?      @map("suggested_contract_id")
  suggestedContract   Contract? @relation("PaymentImportSuggested", fields: [suggestedContractId], references: [id])

  matchedContractId Int?      @map("matched_contract_id")
  matchedContract   Contract? @relation("PaymentImportMatched", fields: [matchedContractId], references: [id])

  resultingPaymentId Int?     @unique @map("resulting_payment_id")
  resultingPayment   Payment? @relation(fields: [resultingPaymentId], references: [id])

  reviewedByUserId Int?      @map("reviewed_by_user_id")
  reviewedAt       DateTime? @map("reviewed_at")

  @@unique([source, externalId])
  @@index([status])
  @@map("payment_import_records")
}

enum PaymentIntentStatus {
  CREATED
  PENDING_BANK
  SUCCEEDED
  FAILED
  CANCELED
  EXPIRED
}

model PaymentIntent {
  id         Int      @id @default(autoincrement())
  contractId Int      @map("contract_id")
  contract   Contract @relation(fields: [contractId], references: [id])

  amount      Decimal             @db.Decimal(12, 2)
  status      PaymentIntentStatus @default(CREATED)
  description String              @map("description")

  penaltyOnly Boolean @default(false) @map("penalty_only")

  payerFullName String  @map("payer_full_name")
  payerEmail    String? @map("payer_email")
  payerPhone    String? @map("payer_phone")

  bankToken     String? @unique @map("bank_token")
  bankRawStatus Json?   @map("bank_raw_status")

  fiscalUuid       String? @map("fiscal_uuid")
  fiscalStatus     String? @map("fiscal_status")
  fiscalReceiptUrl String? @map("fiscal_receipt_url")

  failureReason String? @map("failure_reason")

  paymentId Int?     @unique @map("payment_id")
  payment   Payment? @relation(fields: [paymentId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([contractId])
  @@index([status])
  @@map("payment_intents")
}


model ChatConversation {
  id            Int        @id @default(autoincrement())
  individualUid String     @unique @map("individual_uid")
  individual    Individual @relation(fields: [individualUid], references: [fizicheskoyeLitsoUid])

  lastMessageAt      DateTime  @default(now()) @map("last_message_at")
  staffLastReadAt    DateTime? @map("staff_last_read_at")
  residentLastReadAt DateTime? @map("resident_last_read_at")

  messages ChatMessage[]

  createdAt DateTime @default(now()) @map("created_at")

  @@map("chat_conversations")
}

enum ChatSenderRole {
  RESIDENT
  STAFF
}

model ChatMessage {
  id             Int              @id @default(autoincrement())
  conversationId Int              @map("conversation_id")
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderUserId   Int              @map("sender_user_id")
  sender         User             @relation(fields: [senderUserId], references: [id])
  senderRole     ChatSenderRole   @map("sender_role")

  body String?

  attachments ChatAttachment[]
  broadcastRecipient ChatBroadcastRecipient?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([conversationId, createdAt])
  @@map("chat_messages")
}

enum ChatAttachmentKind {
  IMAGE
  VIDEO
}

model ChatAttachment {
  id         Int                @id @default(autoincrement())
  messageId  Int                @map("message_id")
  message    ChatMessage        @relation(fields: [messageId], references: [id], onDelete: Cascade)
  kind       ChatAttachmentKind
  mimeType   String             @map("mime_type")
  fileName   String             @map("file_name")
  sizeBytes  Int                @map("size_bytes")
  fileId     Int                @map("file_id")
  file       ChatStoredFile     @relation(fields: [fileId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@index([messageId])
  @@index([fileId])
  @@map("chat_attachments")
}

model ChatStoredFile {
  id         Int      @id @default(autoincrement())
  storageKey String   @unique @map("storage_key")
  createdAt  DateTime @default(now()) @map("created_at")

  attachments ChatAttachment[]
  broadcastFiles ChatBroadcastFile[]

  @@map("chat_stored_files")
}

model ChatBroadcast {
  id           Int      @id @default(autoincrement())
  requestId    String   @unique @map("request_id")
  senderUserId Int      @map("sender_user_id")
  sender       User     @relation(fields: [senderUserId], references: [id])
  body         String
  createdAt    DateTime @default(now()) @map("created_at")

  files       ChatBroadcastFile[]
  recipients  ChatBroadcastRecipient[]

  @@map("chat_broadcasts")
}

model ChatBroadcastFile {
  id          Int                @id @default(autoincrement())
  broadcastId Int                @map("broadcast_id")
  broadcast   ChatBroadcast      @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  fileId      Int                @map("file_id")
  file        ChatStoredFile     @relation(fields: [fileId], references: [id])
  kind        ChatAttachmentKind
  mimeType    String             @map("mime_type")
  fileName    String             @map("file_name")
  sizeBytes   Int                @map("size_bytes")

  @@unique([broadcastId, fileId])
  @@map("chat_broadcast_files")
}

enum ChatBroadcastRecipientStatus {
  PENDING
  SENT
  FAILED
}

model ChatBroadcastRecipient {
  id            Int                          @id @default(autoincrement())
  broadcastId   Int                          @map("broadcast_id")
  broadcast     ChatBroadcast                @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  individualUid String                       @map("individual_uid")
  status        ChatBroadcastRecipientStatus @default(PENDING)
  attempts      Int                          @default(0)
  lastError     String?                      @map("last_error")
  messageId     Int?                         @unique @map("message_id")
  message       ChatMessage?                 @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@unique([broadcastId, individualUid])
  @@index([status, id])
  @@map("chat_broadcast_recipients")
}

model Announcement {
  id    Int    @id @default(autoincrement())
  title String
  body  String

  authorUserId Int  @map("author_user_id")
  author       User @relation(fields: [authorUserId], references: [id])

  reads AnnouncementRead[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("announcements")
}

model AnnouncementRead {
  id Int @id @default(autoincrement())

  announcementId Int          @map("announcement_id")
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  userId Int  @map("user_id")
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  readAt DateTime @default(now()) @map("read_at")

  @@unique([announcementId, userId])
  @@index([userId])
  @@map("announcement_reads")
}

enum NotificationChannel {
  TELEGRAM
  MAX
}

enum NotificationKind {
  ANNOUNCEMENT
  CHAT
}

enum NotificationStatus {
  PENDING
  PROCESSING
  SENT
  SKIPPED
  FAILED
}

model NotificationLink {
  id             Int                 @id @default(autoincrement())
  userId         Int                 @map("user_id")
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel        NotificationChannel
  externalId     String              @map("external_id")
  enabled        Boolean             @default(true)
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  @@unique([userId, channel])
  @@unique([channel, externalId])
  @@map("notification_links")
}

model NotificationLinkToken {
  id         Int                 @id @default(autoincrement())
  userId     Int                 @map("user_id")
  channel    NotificationChannel
  tokenHash  String              @unique @map("token_hash")
  expiresAt  DateTime            @map("expires_at")
  createdAt  DateTime            @default(now()) @map("created_at")

  @@index([userId, channel])
  @@map("notification_link_tokens")
}

model NotificationDelivery {
  id             Int                 @id @default(autoincrement())
  userId         Int                 @map("user_id")
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel        NotificationChannel
  kind           NotificationKind
  sourceId       Int                 @map("source_id")
  status         NotificationStatus  @default(PENDING)
  dueAt          DateTime            @map("due_at")
  attempts       Int                 @default(0)
  lastError      String?             @map("last_error")
  providerId     String?             @map("provider_id")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  @@unique([userId, channel, kind, sourceId])
  @@index([status, dueAt])
  @@map("notification_deliveries")
}
